# ARCADIA_ACCESS_KEYS: JSON object mapping personnel userId -> access key secret.
# REQUIRED in production — login is refused until this is set. In AI Studio,
# paste the whole JSON object as the secret value via the Secrets panel.
# Example: {"usr-lead":"<random-1>","usr-arch":"<random-2>","usr-sec":"<random-3>",
#           "usr-dev":"<random-4>","usr-ops":"<random-5>","usr-client":"<random-6>"}
# Without it (dev only), the server accepts the demo key "Arcadia-Demo-2026!"
# and logs a security warning.
# ARCADIA_ACCESS_KEYS='{"usr-lead":"...","usr-arch":"...","usr-sec":"...","usr-dev":"...","usr-ops":"...","usr-client":"..."}'

# ARCADIA_DATA_FILE: where the server persists its JSON state snapshot.
# Defaults to ./arcadia-data.json. Saved every 60s and on shutdown.
# ARCADIA_DATA_FILE="/data/arcadia-data.json"

# ARCADIA_SEED_DEMO_DATA: set to "false" to boot with only the organization
# + personnel (no sample project/content). Defaults: demo content is seeded
# in non-production, skipped in production.
# ARCADIA_SEED_DEMO_DATA="false"

# TURSO_DATABASE_URL / TURSO_AUTH_TOKEN: durable snapshot backend.
# When BOTH are set, state snapshots go to Turso (libSQL) instead of the
# local file, so data survives Cloud Run instance replacement. In AI Studio,
# add both via the Secrets panel. Get them free at https://turso.tech —
# create a database, then use its URL (libsql://... or https://...) and
# an auth token (turso db tokens create <db-name>).
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="your-token"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
